{
  "name": "schema-telegram-botnest",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "prisma migrate deploy && exec node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "prisma migrate deploy && exec node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "node scripts/setup-merge-drivers.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "rotate-encryption": "node dist/cli/rotate-encryption-key.js",
    "mutation": "stryker run",
    "smoke": "playwright test",
    "mutation:golden-auth": "stryker run stryker.golden-auth.config.json",
    "mutation:golden-payments": "stryker run stryker.golden-payments.config.json",
    "mutation:crisis": "stryker run stryker.crisis.config.json",
    "mutation:outbox": "stryker run stryker.outbox.config.json",
    "check-phrases": "ts-node scripts/check-db-phrases.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tma.js/init-data-node": "^2.0.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^7.0.6",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "babel-plugin-istanbul": "^8.0.0",
    "test-exclude": "^8.0.0",
    "glob": "^13.0.6",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "fast-uri": "^3.1.7",
    "mysql2": "^3.24.3",
    "deepmerge-ts": "^8.0.1",
    "multer": "^2.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "/node_modules/@nestjs/(common|core|testing|platform-express|config|schedule|serve-static)/.+\\.js$": "<rootDir>/test-support/esm-to-cjs.transform.cjs",
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 24,
        "branches": 19,
        "functions": 19,
        "lines": 24
      }
    },
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test-support/exit-code-leak.setup.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!@nestjs/(common|core|testing|platform-express|config|schedule|serve-static)/)"
    ]
  }
}
