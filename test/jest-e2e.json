{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": [
    "<rootDir>/e2e-support/env.setup.ts",
    "<rootDir>/setup-e2e.ts"
  ],
  "setupFilesAfterEnv": ["<rootDir>/e2e-support/throttle-reset.setup.ts"],
  "moduleNameMapper": {
    "^jose$": "<rootDir>/e2e-support/jose.stub.ts"
  },
  "transform": {
    "/node_modules/@nestjs/(common|core|testing|platform-express|config|schedule|serve-static)/.+\\.js$": "<rootDir>/../src/test-support/esm-to-cjs.transform.cjs",
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!@nestjs/(common|core|testing|platform-express|config|schedule|serve-static)/)"
  ]
}
