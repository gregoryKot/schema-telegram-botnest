{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "appendPlugins": [
    "./scripts/stryker/covering-test-files.plugin.mjs"
  ],
  "jest": {
    "projectType": "custom",
    "configFile": "package.json",
    "config": {
      "filter": "<rootDir>/../scripts/stryker/covering-test-files.cjs"
    }
  },
  "mutate": [
    "src/utils/crypto.ts",
    "src/utils/crypto-keys.ts",
    "src/utils/crypto-record.ts",
    "src/auth/auth.service.ts",
    "src/booking/robokassa.service.ts",
    "src/utils/tz.ts",
    "src/auth/merge.service.ts",
    "src/auth/merge-relations.ts",
    "src/therapy/therapy-relations.service.ts",
    "src/api/telegram-auth.guard.ts",
    "src/notification/notification.planner.service.ts",
    "src/booking/booking.service.ts",
    "src/booking/payment-guard.ts",
    "src/booking/booking-data.ts",
    "src/subscription/subscription.service.ts",
    "src/subscription/subscription-price.ts",
    "src/subscription/subscription-views.ts",
    "src/booking/slot.service.ts",
    "src/booking/pricing.service.ts",
    "src/booking/price-rules.ts",
    "src/booking/whole-price.ts",
    "src/booking/booking-amount.ts",
    "src/booking/payment.controller.ts",
    "src/auth/security-log.service.ts",
    "src/auth/security-log-redact.ts",
    "src/donation/donation.service.ts"
  ],
  "mutator": {
    "excludedMutations": ["CallExpression"]
  },
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json",
    "covering-test-files"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 60000,
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
