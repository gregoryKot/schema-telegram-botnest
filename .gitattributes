# Правила слияния для файлов, которые вынуждены трогать почти все параллельные
# агенты. Сами драйверы ставятся в .git/config через npm `prepare`
# (scripts/setup-merge-drivers.mjs) — без установки строки ниже молча
# деградируют до обычного текстового слияния.
#
# ВАЖНО: драйверы работают только при слиянии НА МАШИНЕ. Кнопка «Resolve
# conflicts» в вебе GitHub их не знает — конфликтующий PR сводится локально
# (git fetch origin main && git merge origin/main), а не в браузере.

# ── Бейслайны храповиков ─────────────────────────────────────────────────────
# Сводятся по семантике храповика, а не построчно: прогресс обеих сторон
# сохраняется, планка не может случайно опуститься. См. merge-json-ratchet.mjs.

# меньше — лучше, и число складывается: строки файла, байты всего JS, нарушения
# в файле. Две ветки, дописавшие по блоку (или одна ужала, другая дописала), на
# слитом дереве дают базу плюс обе дельты — её драйвер и ставит:
# base + (ours − base) + (theirs − base). min тут терял рост одной стороны
# (CI краснел «файл вырос», 2026-11-06) и ужатие другой (планка молча слабела).
# Исключение по ключу (самый тяжёлый чанк бандла — max) — KEY_MODES в
# scripts/merge-json-ratchet-rules.mjs.
scripts/file-size-baseline.json           merge=ratchet-sum
scripts/bundle-size-baseline.json         merge=ratchet-sum
scripts/robot-phrases-baseline.json       merge=ratchet-sum
scripts/gendered-forms-baseline.json      merge=ratchet-sum
scripts/address-form-baseline.json        merge=ratchet-sum
scripts/eslint-baseline.json              merge=ratchet-sum
scripts/weak-assert-baseline.json         merge=ratchet-sum
scripts/jscpd-baseline.json               merge=ratchet-sum
scripts/silent-catch-baseline.json        merge=ratchet-sum
scripts/tiny-fonts-baseline.json          merge=ratchet-sum
scripts/scale-drift-baseline.json         merge=ratchet-sum
scripts/render-poison-baseline.json       merge=ratchet-sum
scripts/tap-targets-baseline.json         merge=ratchet-sum
scripts/color-drift-baseline.json         merge=ratchet-sum
scripts/second-person-baseline.json       merge=ratchet-sum

# меньше — лучше, но число НЕ складывается — берётся min из двух.
# Планки планов запросов: страницы зависят от выбранного плана, потолок времени
# ставит человек (scripts/check-query-plans.mjs). a11y — число правил axe,
# нарушенных на экране: одно правило, задетое двумя ветками, — одно нарушение.
scripts/query-plan-baseline.json          merge=ratchet-min
e2e-browser/a11y-baseline.json            merge=ratchet-min

# Реестры-классификации (ключ → {status, reason, …}, листья — строки).
# Ratchet-драйвер тут не про числа, а про трёхстороннее слияние по ключам:
# соседние вставки двух PR в отсортированный реестр текстово конфликтуют по
# построению, а драйвер сводит их обоих; если обе стороны переписали ОДНУ
# причину по-разному — выход 1, обычный конфликт человеку (выдумывать нечего).
scripts/alert-throttle-baseline.json      merge=ratchet-min
scripts/body-dto-baseline.json            merge=ratchet-min
scripts/body-truncation-baseline.json     merge=ratchet-min
scripts/dead-end-report-baseline.json     merge=ratchet-min
scripts/dead-files-baseline.json          merge=ratchet-min
scripts/doc-refs-baseline.json            merge=ratchet-min
scripts/dto-string-bounds-baseline.json   merge=ratchet-min
scripts/public-scripts-baseline.json      merge=ratchet-min
scripts/capability-registry-baseline.json merge=ratchet-min
scripts/cron-leader-baseline.json         merge=ratchet-min
scripts/history-sheet-baseline.json       merge=ratchet-min
scripts/incident-registry-baseline.json   merge=ratchet-min
scripts/local-cache-baseline.json         merge=ratchet-min
scripts/mutation-zone-baseline.json       merge=ratchet-min
scripts/persistent-throttle-baseline.json merge=ratchet-min
scripts/raw-sql-live-baseline.json        merge=ratchet-min
scripts/recorded-fixtures-baseline.json   merge=ratchet-min
scripts/unwatched-code-baseline.json      merge=ratchet-min

# больше — лучше
scripts/coverage-baseline.json            merge=ratchet-max
scripts/frontend-coverage-baseline.json   merge=ratchet-max
scripts/mutation-baseline.json            merge=ratchet-max
scripts/mutation-crisis-baseline.json     merge=ratchet-max
scripts/mutation-outbox-baseline.json     merge=ratchet-max
scripts/mutation-golden-auth-baseline.json     merge=ratchet-max
scripts/mutation-golden-payments-baseline.json merge=ratchet-max

# Новый `*-baseline.json` без строки выше краснит `setup-merge-drivers.mjs
# --check` (CI, джоба checks): catch-all тут нельзя, забытый «больше — лучше»
# бейслайн получил бы min. Выбирай направление явно.

# ── Журналы только на дозапись ───────────────────────────────────────────────
# Встроенный драйвер git `union`: при слиянии остаются строки обеих сторон, без
# конфликта. Годится только файлу, где каждый PR дописывает строки в хвост и
# порядок не значим (журнал навигации агентов). Только точным путём, без масок;
# бейслайнам union не подходит — им нужна семантика храповика. Оба условия
# держит scripts/merge-drivers-check.mjs.
docs/agent/NAV_LOG.md                     merge=union
# Сам этот файл: каждый новый бейслайн приносит сюда строку, и два PR с новыми
# гейтами вставляли их в соседние места — текстовый конфликт по построению.
# Строки про разные точные пути друг от друга не зависят, union оставляет обе.
# Обе стороны переписали ОДНУ строку — останутся обе, и повтор пути краснит
# `setup-merge-drivers.mjs --check` (scripts/merge-drivers-check.mjs, п. 5).
.gitattributes                            merge=union
